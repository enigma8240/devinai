<?xml version='1.0' encoding='utf-8' ?>
<merge android:layout_width="wrap_content"
       android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:newenigmahd="http://schemas.android.com/apk/res-auto" xmlns:netest="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:layout_gravity="start"
                android:orientation="vertical"
                android:id="@id/mtrl_picker_header"
                android:paddingLeft="@dimen/mtrl_calendar_header_content_padding"
                android:paddingRight="@dimen/mtrl_calendar_header_content_padding"
                android:paddingBottom="@dimen/mtrl_calendar_header_content_padding"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:paddingStart="@dimen/mtrl_calendar_header_content_padding"
                android:paddingEnd="@dimen/mtrl_calendar_header_content_padding"
                style="?attr/materialCalendarHeaderLayout">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@id/mtrl_picker_header_title_and_selection"
                          android:paddingLeft="@dimen/mtrl_calendar_header_text_padding"
                          android:focusable="false"
                          android:focusableInTouchMode="false"
                          android:layout_width="@dimen/mtrl_calendar_landscape_header_width"
                          android:layout_height="0.0dp"
                          android:layout_weight="1.0"
                          android:importantForAccessibility="yes"
                          android:paddingStart="@dimen/mtrl_calendar_header_text_padding">
      <androidx.constraintlayout.widget.Guideline android:orientation="horizontal"
                            android:id="@id/guideline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            netest:layout_constraintGuide_percent="0.55" />
      <TextView android:id="@id/mtrl_picker_title_text"
                android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                netest:layout_constrainedHeight="true"
                netest:layout_constraintBottom_toTopOf="@id/guideline"
                netest:layout_constraintEnd_toEndOf="parent"
                netest:layout_constraintStart_toStartOf="parent"
                netest:layout_constraintTop_toTopOf="parent"
                netest:layout_constraintVertical_bias="0.0"
                netest:firstBaselineToTopHeight="@dimen/mtrl_calendar_title_baseline_to_top"
                style="?attr/materialCalendarHeaderTitle" />
      <TextView android:id="@id/mtrl_picker_header_selection_text"
                android:layout_width="0.0dp"
                android:layout_height="0.0dp"
                netest:layout_constrainedHeight="true"
                netest:layout_constraintBottom_toBottomOf="parent"
                netest:layout_constraintEnd_toEndOf="parent"
                netest:layout_constraintStart_toStartOf="parent"
                netest:layout_constraintTop_toBottomOf="@id/mtrl_picker_title_text"
                netest:lineHeight="@dimen/mtrl_calendar_header_selection_line_height"
                style="?attr/materialCalendarHeaderSelection" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include layout="@layout/mtrl_picker_header_toggle" />
  </LinearLayout>
  <View android:layout_gravity="end"
        android:layout_width="@dimen/mtrl_calendar_header_divider_thickness"
        android:layout_height="fill_parent"
        style="?attr/materialCalendarHeaderDivider" />
</merge>