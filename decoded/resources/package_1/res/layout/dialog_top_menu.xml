<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <TableRow android:layout_width="fill_parent"
            android:layout_height="wrap_content">
    <android.widget.Button android:id="@id/audioBtn"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:text="@string/open_external_audio"
                          android:layout_weight="1.0"
                          android:textAllCaps="false"
                          style="@style/Widget.AppCompat.Button.Borderless" />
    <android.widget.Button android:id="@id/subBtn"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:text="@string/open_external_sub"
                          android:layout_weight="1.0"
                          android:textAllCaps="false"
                          style="@style/Widget.AppCompat.Button.Borderless" />
  </TableRow>
  <android.widget.Button android:id="@id/playlistBtn"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_playlist"
                        android:textAllCaps="false"
                        style="@style/Widget.AppCompat.Button.Borderless" />
  <android.widget.Button android:id="@id/backgroundBtn"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/resume_bg_playback"
                        android:textAllCaps="false"
                        style="@style/Widget.AppCompat.Button.Borderless" />
  <TableRow android:id="@id/rowChapter"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
    <android.widget.Button android:id="@id/chapterBtn"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:text="@string/chapter_button"
                          android:layout_weight="4.0"
                          android:textAllCaps="false"
                          style="@style/Widget.AppCompat.Button.Borderless" />
    <android.widget.Button android:id="@id/chapterPrev"
                          android:background="@drawable/alpha_darken"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:text="@string/dialog_prev"
                          android:layout_weight="1.0"
                          android:textAllCaps="false"
                          style="@style/Widget.AppCompat.Button.Borderless" />
    <android.widget.Button android:id="@id/chapterNext"
                          android:background="@drawable/alpha_darken"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:text="@string/dialog_next"
                          android:layout_weight="1.0"
                          android:textAllCaps="false"
                          style="@style/Widget.AppCompat.Button.Borderless" />
  </TableRow>
  <android.widget.Button android:id="@id/advancedBtn"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/advanced_menu"
                        android:textAllCaps="false"
                        style="@style/Widget.AppCompat.Button.Borderless" />
  <android.widget.Button android:id="@id/orientationBtn"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_orientation"
                        android:textAllCaps="false"
                        style="@style/Widget.AppCompat.Button.Borderless" />
</LinearLayout>