<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="@color/playlist_bg"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:newenigmahd="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24.0dp"
                android:layout_marginTop="16.0dp"
                android:layout_marginRight="24.0dp"
                android:layout_marginHorizontal="24.0dp">
    <TextView android:textAppearance="@style/TextAppearance.AppCompat.Title"
              android:textColor="@color/playlist_text"
              android:visibility="gone"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:text="@string/action_playlist"
              android:layout_weight="1.0" />
    <android.widget.ImageButton android:id="@id/shuffleBtn"
                          android:background="?android:attr/selectableItemBackground"
                          android:paddingLeft="8.0dp"
                          android:paddingRight="8.0dp"
                          android:layout_width="wrap_content"
                          android:layout_height="fill_parent"
                          android:src="@drawable/ic_shuffle_24dp"
                          android:paddingHorizontal="8.0dp" />
    <android.widget.ImageButton android:id="@id/repeatBtn"
                          android:background="?android:attr/selectableItemBackground"
                          android:paddingLeft="8.0dp"
                          android:paddingRight="8.0dp"
                          android:layout_width="wrap_content"
                          android:layout_height="fill_parent"
                          android:src="@drawable/ic_repeat_24dp"
                          android:paddingHorizontal="8.0dp" />
  </LinearLayout>
  <androidx.recyclerview.widget.RecyclerView android:id="@id/list"
                        android:padding="8.0dp"
                        android:layout_width="fill_parent"
                        android:layout_height="0.0dp"
                        android:layout_weight="1.0"
                        newenigmahd:layoutManager="LinearLayoutManager" />
  <View android:background="?android:attr/listDivider"
        android:layout_width="fill_parent"
        android:layout_height="1.0dp" />
  <TableRow android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
    <android.widget.Button android:id="@id/fileBtn"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:text="@string/action_pick_file"
                          android:layout_weight="1.0"
                          style="@style/Widget.AppCompat.Button.Borderless.Colored" />
    <android.widget.Button android:id="@id/urlBtn"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:text="@string/action_open_url"
                          android:layout_weight="1.0"
                          style="@style/Widget.AppCompat.Button.Borderless.Colored" />
  </TableRow>
</LinearLayout>