<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:layout_width="fill_parent"
                android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:newenigmahd="http://schemas.android.com/apk/res-auto">
  <is.xyz.mpv.MPVView android:id="@id/player"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent" />
  <RelativeLayout android:id="@id/outside"
                  android:layout_width="fill_parent"
                  android:layout_height="fill_parent">
    <LinearLayout android:orientation="vertical"
                  android:id="@id/controls"
                  android:background="#ff000000"
                  android:padding="8.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="24.0dp"
                  android:layout_marginTop="60.0dp"
                  android:layout_marginRight="24.0dp"
                  android:layout_marginBottom="24.0dp"
                  android:layout_alignParentBottom="true"
                  android:layout_centerHorizontal="true"
                  style="?attr/buttonBarStyle">
      <LinearLayout android:orientation="vertical"
                    android:id="@id/controls_title_group"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
        <TextView android:textSize="24.0sp"
                  android:textColor="@color/tint_normal"
                  android:gravity="center"
                  android:id="@id/titleTextView"
                  android:visibility="gone"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content" />
        <TextView android:textSize="14.0sp"
                  android:textColor="@color/tint_normal"
                  android:gravity="center"
                  android:id="@id/minorTitleTextView"
                  android:visibility="gone"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content" />
        <TextView android:textSize="16.0sp"
                  android:textColor="@color/tint_normal"
                  android:ellipsize="middle"
                  android:gravity="center"
                  android:id="@id/fullTitleTextView"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:singleLine="true" />
      </LinearLayout>
      <LinearLayout android:orientation="horizontal"
                    android:id="@id/controls_seekbar_group"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:weightSum="100.0"
                    android:layoutDirection="ltr">
        <TextView android:textColor="@android:color/white"
                  android:gravity="center"
                  android:id="@id/playbackPositionTxt"
                  android:padding="8.0dp"
                  android:layout_width="wrap_content"
                  android:layout_height="fill_parent" />
        <SeekBar android:layout_gravity="center_vertical"
                 android:id="@id/playbackSeekbar"
                 android:layout_width="0.0dp"
                 android:layout_height="fill_parent"
                 android:minHeight="24.0dp"
                 android:layout_weight="100.0"
                 android:progressBackgroundTint="@color/tint_seekbar_bg" />
        <TextView android:textColor="@android:color/white"
                  android:gravity="center"
                  android:id="@id/playbackDurationTxt"
                  android:padding="8.0dp"
                  android:layout_width="wrap_content"
                  android:layout_height="fill_parent" />
      </LinearLayout>
      <LinearLayout android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/controls_button_group"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layoutDirection="ltr">
        <ImageButton android:id="@id/prevBtn"
                     android:background="@drawable/ne_player_btn_bg"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:src="@drawable/ic_skip_previous_black_24dp"
                     android:tint="@color/ne_player_btn_icon_tint"
                     android:minWidth="48.0dp"
                     android:minHeight="48.0dp"
                     android:defaultFocusHighlightEnabled="false"
                     newenigmahd:backgroundTint="@null" />
        <ImageButton android:id="@id/cycleAudioBtn"
                     android:background="@drawable/ne_player_btn_bg"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:src="@drawable/ic_audiotrack_black_24dp"
                     android:tint="@color/ne_player_btn_icon_tint"
                     android:minWidth="48.0dp"
                     android:minHeight="48.0dp"
                     android:layout_marginStart="14.0dp"
                     android:defaultFocusHighlightEnabled="false"
                     newenigmahd:backgroundTint="@null" />
        <ImageButton android:id="@id/cycleSubsBtn"
                     android:background="@drawable/ne_player_btn_bg"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:src="@drawable/ic_subtitles_black_24dp"
                     android:tint="@color/ne_player_btn_icon_tint"
                     android:minWidth="48.0dp"
                     android:minHeight="48.0dp"
                     android:layout_marginStart="14.0dp"
                     android:defaultFocusHighlightEnabled="false"
                     newenigmahd:backgroundTint="@null" />
        <ImageButton android:textColor="@android:color/white"
                     android:id="@id/playBtn"
                     android:background="@drawable/ne_player_btn_bg"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:tint="@color/ne_player_btn_icon_tint"
                     android:minWidth="48.0dp"
                     android:minHeight="48.0dp"
                     android:layout_marginStart="14.0dp"
                     android:defaultFocusHighlightEnabled="false"
                     newenigmahd:backgroundTint="@null" />
        <Button android:textColor="@android:color/white"
                android:id="@id/cycleDecoderBtn"
                android:background="@drawable/ne_player_btn_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:defaultFocusHighlightEnabled="false"
                newenigmahd:backgroundTint="@null" />
        <Button android:textColor="@android:color/white"
                android:id="@id/cycleSpeedBtn"
                android:background="@drawable/ne_player_btn_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48.0dp"
                android:minHeight="48.0dp"
                android:layout_marginStart="14.0dp"
                android:defaultFocusHighlightEnabled="false"
                newenigmahd:backgroundTint="@null" />
        <ImageButton android:id="@id/openPlaylistBtn"
                     android:background="@drawable/ne_player_btn_bg"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:src="@drawable/ic_playlist_black_24dp"
                     android:tint="@color/ne_player_btn_icon_tint"
                     android:minWidth="48.0dp"
                     android:minHeight="48.0dp"
                     android:layout_marginStart="14.0dp"
                     android:defaultFocusHighlightEnabled="false"
                     newenigmahd:backgroundTint="@null" />
        <Button android:textColor="@android:color/white"
                android:id="@id/kaliteBtn"
                android:background="@drawable/ne_player_btn_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48.0dp"
                android:minHeight="48.0dp"
                android:text="Kalite"
                android:layout_marginStart="14.0dp"
                android:defaultFocusHighlightEnabled="false"
                newenigmahd:backgroundTint="@null" />
        <ImageButton android:id="@id/nextBtn"
                     android:background="@drawable/ne_player_btn_bg"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:src="@drawable/ic_skip_next_black_24dp"
                     android:tint="@color/ne_player_btn_icon_tint"
                     android:minWidth="48.0dp"
                     android:minHeight="48.0dp"
                     android:layout_marginStart="14.0dp"
                     android:defaultFocusHighlightEnabled="false"
                     newenigmahd:backgroundTint="@null" />
        <LinearLayout android:orientation="horizontal"
                      android:id="@id/top_controls"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8.0dp">
          <ImageButton android:id="@id/topLockBtn"
                       android:background="@drawable/ne_player_btn_bg"
                       android:padding="4.0dp"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:src="@drawable/ic_lock_24dp"
                       android:tint="@color/ne_player_btn_icon_tint"
                       android:minWidth="40.0dp"
                       android:minHeight="40.0dp"
                       android:defaultFocusHighlightEnabled="false"
                       newenigmahd:backgroundTint="@null" />
          <ImageButton android:id="@id/topPiPBtn"
                       android:background="@drawable/ne_player_btn_bg"
                       android:padding="4.0dp"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:src="@drawable/ic_picture_in_picture_24dp"
                       android:tint="@color/ne_player_btn_icon_tint"
                       android:minWidth="40.0dp"
                       android:minHeight="40.0dp"
                       android:defaultFocusHighlightEnabled="false"
                       newenigmahd:backgroundTint="@null" />
          <ImageButton android:id="@id/topMenuBtn"
                       android:background="@drawable/ne_player_btn_bg"
                       android:padding="4.0dp"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:src="@drawable/ic_settings_black_24dp"
                       android:tint="@color/ne_player_btn_icon_tint"
                       android:minWidth="40.0dp"
                       android:minHeight="40.0dp"
                       android:defaultFocusHighlightEnabled="false"
                       newenigmahd:backgroundTint="@null" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <TextView android:textColor="#00ff00"
              android:id="@id/statsTextView"
              android:visibility="gone"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:shadowColor="#000000"
              android:shadowDx="1.0"
              android:shadowDy="1.0"
              android:shadowRadius="1.0"
              android:layout_alignParentTop="true"
              android:layout_marginStart="16.0dp"
              android:layout_alignParentStart="true" />
    <TextView android:textSize="36.0sp"
              android:textStyle="bold"
              android:textColor="#ffffff"
              android:gravity="center"
              android:id="@id/gestureTextView"
              android:visibility="gone"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:shadowColor="#000000"
              android:shadowDx="0.0"
              android:shadowDy="0.0"
              android:shadowRadius="4.0"
              android:textAlignment="center" />
    <ImageButton android:id="@id/unlockBtn"
                 android:visibility="gone"
                 android:layout_width="48.0dp"
                 android:layout_height="52.0dp"
                 android:layout_marginTop="24.0dp"
                 android:layout_marginBottom="24.0dp"
                 android:src="@drawable/ic_lock_open_24dp"
                 android:layout_alignParentTop="true"
                 android:layout_marginStart="24.0dp"
                 android:layout_marginEnd="24.0dp"
                 android:layout_alignParentEnd="true" />
  </RelativeLayout>
</RelativeLayout>