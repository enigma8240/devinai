<?xml version='1.0' encoding='utf-8' ?>
<ScrollView android:layout_width="fill_parent"
            android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <TableRow android:id="@id/rowVideo1"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content">
      <android.widget.Button android:id="@id/contrastBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/contrast"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/brightnessBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/video_brightness"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
    </TableRow>
    <TableRow android:id="@id/rowVideo2"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent">
      <android.widget.Button android:id="@id/gammaBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/gamma"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/saturationBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/saturation"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
    </TableRow>
    <TableRow android:id="@id/rowSubSeek"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content">
      <android.widget.Button android:id="@id/subSeekBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/sub_seek_button"
                            android:layout_weight="4.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/subSeekPrev"
                            android:background="@drawable/alpha_darken"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_prev"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/subSeekNext"
                            android:background="@drawable/alpha_darken"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_next"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
    </TableRow>
    <TableRow android:layout_width="fill_parent"
              android:layout_height="wrap_content">
      <android.widget.Button android:id="@id/statsBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/toggle_stats"
                            android:layout_weight="4.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/statsBtn1"
                            android:background="@drawable/alpha_darken"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/statsBtn2"
                            android:background="@drawable/alpha_darken"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/statsBtn3"
                            android:background="@drawable/alpha_darken"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
    </TableRow>
    <TableRow android:layout_width="fill_parent"
              android:layout_height="fill_parent">
      <android.widget.Button android:id="@id/audioDelayBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/audio_delay"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
      <android.widget.Button android:id="@id/subDelayBtn"
                            android:layout_width="0.0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/sub_delay"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            style="@style/Widget.AppCompat.Button.Borderless" />
    </TableRow>
    <android.widget.Button android:id="@id/aspectBtn"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:text="@string/aspect_ratio"
                          android:textAllCaps="false"
                          style="@style/Widget.AppCompat.Button.Borderless" />
  </LinearLayout>
</ScrollView>