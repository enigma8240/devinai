<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:gravity="center_vertical"
              android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:layout_margin="64.0dp" xmlns:android="http://schemas.android.com/apk/res/android">
  <TextView android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:gravity="center"
            android:id="@android:id/message"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
  <Button android:id="@id/fileBtn"
          android:paddingTop="16.0dp"
          android:paddingBottom="16.0dp"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16.0dp"
          android:layout_marginBottom="16.0dp"
          android:text="@string/action_pick_file_old"
          android:layout_marginStart="16.0dp"
          android:layout_marginEnd="16.0dp"
          android:paddingVertical="16.0dp" />
  <Button android:id="@id/urlBtn"
          android:paddingTop="16.0dp"
          android:paddingBottom="16.0dp"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16.0dp"
          android:text="@string/action_open_url"
          android:layout_marginStart="16.0dp"
          android:layout_marginEnd="16.0dp"
          android:paddingVertical="16.0dp" />
  <Button android:id="@id/docBtn"
          android:paddingTop="16.0dp"
          android:paddingBottom="16.0dp"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:text="@string/action_open_doc"
          android:layout_marginStart="16.0dp"
          android:layout_marginEnd="16.0dp"
          android:paddingVertical="16.0dp" />
</LinearLayout>