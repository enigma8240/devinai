                  newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_ignore_audio_focus_title"
                        android:key="ignore_audio_focus"
                        android:summary="@string/pref_ignore_audio_focus_summary"
