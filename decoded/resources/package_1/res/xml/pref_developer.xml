                        newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_gpu_debug_title"
                        android:key="gpudebug"
                        android:defaultValue="false"
                        newenigmahd:iconSpaceReserved="false" />
</PreferenceScreen>