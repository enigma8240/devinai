<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:newenigmahd="http://schemas.android.com/apk/res-auto">
  <ListPreference android:entries="@array/stats_entries"
                  android:title="@string/pref_stats_mode_title"
                  android:key="stats_mode"
                  android:summary="@string/pref_stats_mode_summary"
                  android:defaultValue=""
