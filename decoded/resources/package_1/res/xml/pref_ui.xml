<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:newenigmahd="http://schemas.android.com/apk/res-auto">
  <ListPreference android:entries="@array/auto_rotation_entries"
                  android:title="@string/pref_auto_rotation_title"
                  android:key="auto_rotation"
                  android:summary="@string/pref_auto_rotation_summary"
                  android:defaultValue="@string/pref_auto_rotation_default"
                  android:entryValues="@array/auto_rotation_values"
                  newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_display_media_title_title"
                        android:key="display_media_title"
                        android:summary="@string/pref_display_media_title_summary"
                        android:defaultValue="false"
                        newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_bottom_controls_title"
                        android:key="bottom_controls"
                        android:summary=""
                        android:defaultValue="true"
                        newenigmahd:iconSpaceReserved="false" />
  <ListPreference android:entries="@array/background_play_entries"
                  android:title="@string/pref_no_ui_pause_title"
                  android:key="no_ui_pause"
                  android:summary="@string/pref_no_ui_pause_summary"
                  android:defaultValue="@string/pref_no_ui_pause_default"
                  android:entryValues="@array/background_play_values"
                  newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_playlist_exit_warning_title"
                        android:key="playlist_exit_warning"
                        android:summary="@string/pref_playlist_exit_warning_summary"
                        android:defaultValue="true"
                        newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_remember_brightness_title"
                        android:key="remember_brightness"
                        android:summary="@string/pref_remember_brightness_summary"
                        android:defaultValue="false"
                        newenigmahd:iconSpaceReserved="false" />
  <PreferenceCategory android:title="@string/pref_ctrlbar_category_title"
                      newenigmahd:iconSpaceReserved="false">
    <SwitchPreferenceCompat android:title="@string/pref_ctrlbar_zap_title"
                          android:key="ctrlbar_zap"
                          android:summary="@string/pref_ctrlbar_zap_summary"
                          android:defaultValue="true"
                          newenigmahd:iconSpaceReserved="false" />
    <SwitchPreferenceCompat android:title="@string/pref_ctrlbar_audio_title"
                          android:key="ctrlbar_audio"
                          android:summary="@string/pref_ctrlbar_audio_summary"
                          android:defaultValue="true"
                          newenigmahd:iconSpaceReserved="false" />
    <SwitchPreferenceCompat android:title="@string/pref_ctrlbar_subs_title"
                          android:key="ctrlbar_subs"
                          android:summary="@string/pref_ctrlbar_subs_summary"
                          android:defaultValue="true"
                          newenigmahd:iconSpaceReserved="false" />
    <SwitchPreferenceCompat android:title="@string/pref_ctrlbar_hwdec_title"
                          android:key="ctrlbar_hwdec"
                          android:summary="@string/pref_ctrlbar_hwdec_summary"
                          android:defaultValue="true"
                          newenigmahd:iconSpaceReserved="false" />
    <SwitchPreferenceCompat android:title="@string/pref_ctrlbar_speed_title"
                          android:key="ctrlbar_speed"
                          android:summary="@string/pref_ctrlbar_speed_summary"
                          android:defaultValue="true"
                          newenigmahd:iconSpaceReserved="false" />
    <SwitchPreferenceCompat android:title="@string/pref_ctrlbar_playlist_title"
                          android:key="ctrlbar_playlist"
                          android:summary="@string/pref_ctrlbar_playlist_summary"
                          android:defaultValue="true"
                          newenigmahd:iconSpaceReserved="false" />
  </PreferenceCategory>
</PreferenceScreen>