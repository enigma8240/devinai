<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:newenigmahd="http://schemas.android.com/apk/res-auto">
  <EditTextPreference android:hint=""
                      android:title="@string/pref_default_file_manager_path_title"
                      android:key="default_file_manager_path"
                      android:defaultValue="/sdcard"
                      newenigmahd:iconSpaceReserved="false"
                      newenigmahd:useSimpleSummaryProvider="true" />
  <EditTextPreference android:title="@string/pref_default_audio_language_title"
                      android:key="default_audio_language"
                      android:defaultValue="eng"
                      android:dialogMessage="@string/pref_default_audio_language_message"
                      newenigmahd:iconSpaceReserved="false"
                      newenigmahd:useSimpleSummaryProvider="true" />
  <EditTextPreference android:title="@string/pref_default_subtitle_language_title"
                      android:key="default_subtitle_language"
                      android:defaultValue="eng"
                      android:dialogMessage="@string/pref_default_subtitle_language_message"
                      newenigmahd:iconSpaceReserved="false"
                      newenigmahd:useSimpleSummaryProvider="true" />
  <SwitchPreferenceCompat android:title="@string/pref_material_you_theming_title"
                        android:key="material_you_theming"
                        android:summary="@string/pref_material_you_theming_summary"
                        android:defaultValue="false"
                        newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_hardware_decoding_title"
                        android:key="hardware_decoding"
                        android:summary="@string/pref_hardware_decoding_summary"
                        android:defaultValue="false"
                        newenigmahd:iconSpaceReserved="false" />
  <ListPreference android:entries="@array/background_play_entries"
                  android:title="@string/pref_background_play_title"
                  android:key="background_play"
                  android:summary="@string/pref_background_play_summary"
                  android:defaultValue="@string/pref_background_play_default"
                  android:entryValues="@array/background_play_values"
                  newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_save_position_title"
                        android:key="save_position"
                        android:summary="@string/pref_save_position_summary"
                        android:defaultValue="false"
                        newenigmahd:iconSpaceReserved="false" />
  <SwitchPreferenceCompat android:title="@string/pref_new_intent_replace_title"
                        android:key="new_intent_replace"
                        android:summary="@string/pref_new_intent_replace_summary"
                        android:defaultValue="false"
                        newenigmahd:iconSpaceReserved="false" />
</PreferenceScreen>